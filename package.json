{
  "name": "tatagan-sh",
  "private": true,
  "version": "1.8.1",
  "description": "Tatagan.sh — Rastreador mobile-first de treinos, rotinas e relatórios semanais",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
